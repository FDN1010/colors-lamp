@startuml
left to right direction
actor User

rectangle "Colors Web Application" {
  usecase "Log in" as UC1
  usecase "Log out" as UC2
  usecase "Search colors" as UC3
  usecase "Add a color" as UC4
  usecase "Save session cookie" as UC5
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4

UC1 ..> UC5 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC1 : <<include>>
@enduml